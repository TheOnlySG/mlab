' : ldaLRpred\n}\nanalysis","outputs":[{"type":"execute_result","text":"{'simple': 0.0009360313415527344,\n 'PCA': 0.000736236572265625,\n 'LDA': 0.0009381771087646484}"}]},{"number":29,"id":"cell-29","type":"code","source":"anal = pd.DataFrame(analysis)"},{"number":30,"id":"cell-30","type":"code","source":"analysis = {\n    'type': ['Simple LR', 'PCA LR', 'LDA LR'],\n    'training time': [simpleLRtime, pcaLRtime, ldaLRtime]\n}"},{"number":31,"id":"cell-31","type":"code","source":"analysis","outputs":[{"type":"execute_result","text":"{'type': ['Simple LR', 'PCA LR', 'LDA LR'],\n 'training time': [0.10990309715270996,\n  0.08621954917907715,\n  0.07667183876037598]}"}]},{"number":32,"id":"cell-32","type":"code","source":"anal = pd.DataFrame(analysis)\nanal.head()","outputs":[{"type":"execute_result","text":"        type  training time\n0  Simple LR       0.109903\n1     PCA LR       0.086220\n2     LDA LR       0.076672","html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>type</th>\n      <th>training time</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Simple LR</td>\n      <td>0.109903</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>PCA LR</td>\n      <td>0.086220</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>LDA LR</td>\n      <td>0.076672</td>\n    </tr>\n  </tbody>\n</table>\n</div>","htmlIsDataframe":true,"rowCount":4}]},{"number":33,"id":"cell-33","type":"code","source":"import matplotlib.pyplot as plt\nplt.bar(anal['type'], anal['training time'])\nplt.xlabel('Model')\nplt.ylabel('Training Time (seconds)')\nplt.title('Training Time Comparison')\nplt.show()","outputs":[{"type":"display_data","text"